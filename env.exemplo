# Agente da bipagem (roda no SEU computador). Copie este arquivo para ".env" na pasta do projeto e preencha.
# NUNCA suba o ".env" para o GitHub (o .gitignore já bloqueia).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=chave-service_role-aqui
USUARIO=seu-login-na-plataforma
SENHA=sua-senha-na-plataforma

# Opcionais
# BIPAGEM_PAUSA=1.0       # segundos de espera entre ações (aumente se o site estiver lento)
# BIPAGEM_HEADLESS=       # "1" para rodar sem abrir a janela do navegador
